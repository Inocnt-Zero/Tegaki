-- Chapters the scanlator filter removes: lower-priority duplicates and chapters of hidden
-- scanlators. Readers skip these ids instead of ranking every chapter in the library on each query.
-- on a 1,460-entry library that took the library view from ~820 ms to ~125 ms.
--
-- The triggers below keep it current on every write path (sync, restore, sync service, deletes),
-- which is why this is maintained in SQL rather than in Kotlin. The rule:
--  * an entry with no scanlator_filter rows hides nothing,
--  * otherwise its chapters are grouped by number, each unnumbered (< 0) chapter being a group of
--    its own, and ranked: non-excluded first, then priority, then _id. Only the top chapter of a
--    group is kept, and only if its scanlator is not excluded.
--
-- Merged entries are not covered: their dedup spans several entries, so a chapter can lose there
-- and still win in its own entry. The merged queries keep ranking at read time.
CREATE TABLE scanlator_filtered_chapters(
    chapter_id INTEGER NOT NULL PRIMARY KEY,
    manga_id INTEGER NOT NULL,
    FOREIGN KEY(chapter_id) REFERENCES chapters (_id)
    ON DELETE CASCADE
);

CREATE INDEX scanlator_filtered_chapters_manga_id_index ON scanlator_filtered_chapters(manga_id);

-- A chapter write only affects its own number group, and this index lets the triggers recompute just
-- that group, so bulk inserts (a sync, a full restore) stay linear.
CREATE INDEX chapters_manga_id_chapter_number_index ON chapters(manga_id, chapter_number);

CREATE TRIGGER scanlator_filtered_chapters_chapter_insert
AFTER INSERT ON chapters
BEGIN
    DELETE FROM scanlator_filtered_chapters
    WHERE chapter_id IN (
        SELECT _id FROM chapters WHERE manga_id = new.manga_id AND chapter_number = new.chapter_number
    );
    INSERT INTO scanlator_filtered_chapters(chapter_id, manga_id)
    SELECT _id, manga_id FROM (
        SELECT
            C._id,
            C.manga_id,
            coalesce(SF.excluded, 0) AS excluded,
            ROW_NUMBER() OVER (
                PARTITION BY CASE WHEN C.chapter_number < 0 THEN C._id END
                ORDER BY
                    CASE WHEN coalesce(SF.excluded, 0) = 1 THEN 1 ELSE 0 END ASC,
                    coalesce(SF.priority, 10000000) ASC,
                    C._id ASC
            ) AS rank
        FROM chapters C
        LEFT JOIN scanlator_filter SF
            ON SF.manga_id = C.manga_id
            AND SF.scanlator IS C.scanlator
        WHERE C.manga_id = new.manga_id AND C.chapter_number = new.chapter_number
    )
    WHERE excluded = 1 OR rank > 1
    AND EXISTS (SELECT 1 FROM scanlator_filter WHERE manga_id = new.manga_id);
END;

CREATE TRIGGER scanlator_filtered_chapters_chapter_delete
AFTER DELETE ON chapters
BEGIN
    DELETE FROM scanlator_filtered_chapters WHERE chapter_id = old._id;
    DELETE FROM scanlator_filtered_chapters
    WHERE chapter_id IN (
        SELECT _id FROM chapters WHERE manga_id = old.manga_id AND chapter_number = old.chapter_number
    );
    INSERT INTO scanlator_filtered_chapters(chapter_id, manga_id)
    SELECT _id, manga_id FROM (
        SELECT
            C._id,
            C.manga_id,
            coalesce(SF.excluded, 0) AS excluded,
            ROW_NUMBER() OVER (
                PARTITION BY CASE WHEN C.chapter_number < 0 THEN C._id END
                ORDER BY
                    CASE WHEN coalesce(SF.excluded, 0) = 1 THEN 1 ELSE 0 END ASC,
                    coalesce(SF.priority, 10000000) ASC,
                    C._id ASC
            ) AS rank
        FROM chapters C
        LEFT JOIN scanlator_filter SF
            ON SF.manga_id = C.manga_id
            AND SF.scanlator IS C.scanlator
        WHERE C.manga_id = old.manga_id AND C.chapter_number = old.chapter_number
    )
    WHERE excluded = 1 OR rank > 1
    AND EXISTS (SELECT 1 FROM scanlator_filter WHERE manga_id = old.manga_id);
END;

CREATE TRIGGER scanlator_filtered_chapters_chapter_update
AFTER UPDATE OF manga_id, chapter_number, scanlator ON chapters
WHEN old.manga_id IS NOT new.manga_id
    OR old.chapter_number IS NOT new.chapter_number
    OR old.scanlator IS NOT new.scanlator
BEGIN
    DELETE FROM scanlator_filtered_chapters WHERE chapter_id = old._id;
    DELETE FROM scanlator_filtered_chapters
    WHERE chapter_id IN (
        SELECT _id FROM chapters WHERE manga_id = old.manga_id AND chapter_number = old.chapter_number
    );
    INSERT INTO scanlator_filtered_chapters(chapter_id, manga_id)
    SELECT _id, manga_id FROM (
        SELECT
            C._id,
            C.manga_id,
            coalesce(SF.excluded, 0) AS excluded,
            ROW_NUMBER() OVER (
                PARTITION BY CASE WHEN C.chapter_number < 0 THEN C._id END
                ORDER BY
                    CASE WHEN coalesce(SF.excluded, 0) = 1 THEN 1 ELSE 0 END ASC,
                    coalesce(SF.priority, 10000000) ASC,
                    C._id ASC
            ) AS rank
        FROM chapters C
        LEFT JOIN scanlator_filter SF
            ON SF.manga_id = C.manga_id
            AND SF.scanlator IS C.scanlator
        WHERE C.manga_id = old.manga_id AND C.chapter_number = old.chapter_number
    )
    WHERE excluded = 1 OR rank > 1
    AND EXISTS (SELECT 1 FROM scanlator_filter WHERE manga_id = old.manga_id);
    DELETE FROM scanlator_filtered_chapters
    WHERE chapter_id IN (
        SELECT _id FROM chapters WHERE manga_id = new.manga_id AND chapter_number = new.chapter_number
    );
    INSERT INTO scanlator_filtered_chapters(chapter_id, manga_id)
    SELECT _id, manga_id FROM (
        SELECT
            C._id,
            C.manga_id,
            coalesce(SF.excluded, 0) AS excluded,
            ROW_NUMBER() OVER (
                PARTITION BY CASE WHEN C.chapter_number < 0 THEN C._id END
                ORDER BY
                    CASE WHEN coalesce(SF.excluded, 0) = 1 THEN 1 ELSE 0 END ASC,
                    coalesce(SF.priority, 10000000) ASC,
                    C._id ASC
            ) AS rank
        FROM chapters C
        LEFT JOIN scanlator_filter SF
            ON SF.manga_id = C.manga_id
            AND SF.scanlator IS C.scanlator
        WHERE C.manga_id = new.manga_id AND C.chapter_number = new.chapter_number
    )
    WHERE excluded = 1 OR rank > 1
    AND EXISTS (SELECT 1 FROM scanlator_filter WHERE manga_id = new.manga_id);
END;

-- A filter change can reorder every group of the entry, so recompute all of it.
CREATE TRIGGER scanlator_filtered_chapters_filter_insert
AFTER INSERT ON scanlator_filter
BEGIN
    DELETE FROM scanlator_filtered_chapters WHERE manga_id = new.manga_id;
    INSERT INTO scanlator_filtered_chapters(chapter_id, manga_id)
    SELECT _id, manga_id FROM (
        SELECT
            C._id,
            C.manga_id,
            coalesce(SF.excluded, 0) AS excluded,
            ROW_NUMBER() OVER (
                PARTITION BY C.chapter_number, CASE WHEN C.chapter_number < 0 THEN C._id END
                ORDER BY
                    CASE WHEN coalesce(SF.excluded, 0) = 1 THEN 1 ELSE 0 END ASC,
                    coalesce(SF.priority, 10000000) ASC,
                    C._id ASC
            ) AS rank
        FROM chapters C
        LEFT JOIN scanlator_filter SF
            ON SF.manga_id = C.manga_id
            AND SF.scanlator IS C.scanlator
        WHERE C.manga_id = new.manga_id
    )
    WHERE excluded = 1 OR rank > 1
    AND EXISTS (SELECT 1 FROM scanlator_filter WHERE manga_id = new.manga_id);
END;

CREATE TRIGGER scanlator_filtered_chapters_filter_delete
AFTER DELETE ON scanlator_filter
BEGIN
    DELETE FROM scanlator_filtered_chapters WHERE manga_id = old.manga_id;
    INSERT INTO scanlator_filtered_chapters(chapter_id, manga_id)
    SELECT _id, manga_id FROM (
        SELECT
            C._id,
            C.manga_id,
            coalesce(SF.excluded, 0) AS excluded,
            ROW_NUMBER() OVER (
                PARTITION BY C.chapter_number, CASE WHEN C.chapter_number < 0 THEN C._id END
                ORDER BY
                    CASE WHEN coalesce(SF.excluded, 0) = 1 THEN 1 ELSE 0 END ASC,
                    coalesce(SF.priority, 10000000) ASC,
                    C._id ASC
            ) AS rank
        FROM chapters C
        LEFT JOIN scanlator_filter SF
            ON SF.manga_id = C.manga_id
            AND SF.scanlator IS C.scanlator
        WHERE C.manga_id = old.manga_id
    )
    WHERE excluded = 1 OR rank > 1
    AND EXISTS (SELECT 1 FROM scanlator_filter WHERE manga_id = old.manga_id);
END;

CREATE TRIGGER scanlator_filtered_chapters_filter_update
AFTER UPDATE ON scanlator_filter
BEGIN
    DELETE FROM scanlator_filtered_chapters WHERE manga_id = old.manga_id;
    INSERT INTO scanlator_filtered_chapters(chapter_id, manga_id)
    SELECT _id, manga_id FROM (
        SELECT
            C._id,
            C.manga_id,
            coalesce(SF.excluded, 0) AS excluded,
            ROW_NUMBER() OVER (
                PARTITION BY C.chapter_number, CASE WHEN C.chapter_number < 0 THEN C._id END
                ORDER BY
                    CASE WHEN coalesce(SF.excluded, 0) = 1 THEN 1 ELSE 0 END ASC,
                    coalesce(SF.priority, 10000000) ASC,
                    C._id ASC
            ) AS rank
        FROM chapters C
        LEFT JOIN scanlator_filter SF
            ON SF.manga_id = C.manga_id
            AND SF.scanlator IS C.scanlator
        WHERE C.manga_id = old.manga_id
    )
    WHERE excluded = 1 OR rank > 1
    AND EXISTS (SELECT 1 FROM scanlator_filter WHERE manga_id = old.manga_id);
    DELETE FROM scanlator_filtered_chapters WHERE manga_id = new.manga_id;
    INSERT INTO scanlator_filtered_chapters(chapter_id, manga_id)
    SELECT _id, manga_id FROM (
        SELECT
            C._id,
            C.manga_id,
            coalesce(SF.excluded, 0) AS excluded,
            ROW_NUMBER() OVER (
                PARTITION BY C.chapter_number, CASE WHEN C.chapter_number < 0 THEN C._id END
                ORDER BY
                    CASE WHEN coalesce(SF.excluded, 0) = 1 THEN 1 ELSE 0 END ASC,
                    coalesce(SF.priority, 10000000) ASC,
                    C._id ASC
            ) AS rank
        FROM chapters C
        LEFT JOIN scanlator_filter SF
            ON SF.manga_id = C.manga_id
            AND SF.scanlator IS C.scanlator
        WHERE C.manga_id = new.manga_id
    )
    WHERE excluded = 1 OR rank > 1
    AND EXISTS (SELECT 1 FROM scanlator_filter WHERE manga_id = new.manga_id);
END;
